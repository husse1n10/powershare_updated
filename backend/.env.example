PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=powershare
# Per-process connection budget. JawsDB defaults to 2 if unset; local MySQL to 10.
# Set within your database plan's budget across all dynos and other clients.
DB_POOL_SIZE=2
# Heroku's JawsDB add-on supplies JAWSDB_URL automatically. When present it
# takes precedence over DB_HOST, DB_PORT, DB_USER, DB_PASSWORD and DB_NAME.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
DEFAULT_USD_LBP_RATE=89700

COOKIE_SAME_SITE=lax

# Set true after building frontend/ when deploying API + React from one Node service
SERVE_FRONTEND=false
