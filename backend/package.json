{
  "name": "powershare-backend",
  "version": "1.0.0",
  "description": "PowerShare Generator Management System backend - PL/BLL/DAL architecture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "check": "node scripts/check-architecture.js && node scripts/check-syntax.js",
    "check:api": "node scripts/check-api-contract.js",
    "qa": "npm run check && npm run check:api && npm run check:requirements && npm test",
    "test:coverage": "node --experimental-test-coverage --test tests/unit/*.test.js tests/integration/*.test.js",
    "check:requirements": "node scripts/check-requirements.js",
    "test:db": "node scripts/smoke-db.js",
    "qa:docs": "node scripts/generate-traceability.js",
    "db:init": "node scripts/init-db.js",
    "test:e2e:live": "node scripts/e2e-live.js",
    "qa:live": "npm run test:db && npm run test:e2e:live && npm run test:live && npm run test:db",
    "db:seed:demo": "node scripts/seed-demo.js",
    "qa:ci": "npm run db:init && npm run db:seed:demo && npm run qa && npm run qa:live",
    "test:live": "node --test --test-concurrency=1 tests/live/*.test.js",
    "db:migrate": "node scripts/migrate-db.js",
    "db:reset": "node scripts/reset-db.js",
    "db:admin": "node scripts/create-admin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "aws-ssl-profiles": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.4",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
